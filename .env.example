SERPAPI_BASE_URL=

# Optional external vector databases / retrieval.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_CLOUD=
PINECONE_REGION=
PINECONE_HOST=
QDRANT_URL=
QDRANT_API_KEY=
WEAVIATE_URL=
WEAVIATE_API_KEY=

# Optional AI observability. Do not capture raw prompts, private memory or secrets by default.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Optional observability.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=




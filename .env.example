# Optional observability.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# Universal environment registry expansion — optional/future integrations.
# Keep real secrets in the hosting provider's secret store, never in Git.
# Disabled providers remain inactive until credentials and implementation exist.
# ---------------------------------------------------------------------------

# Application URLs, runtime controls and deployment metadata.
APP_NAME=Minglora
APP_VERSION=1.0.0
APP_TIMEZONE=America/Jamaica
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en
APP_DOMAIN=YOUR_APP_DOMAIN_HERE
API_BASE_URL=YOUR_API_BASE_URL_HERE
API_PORT=YOUR_API_PORT_HERE
APP_SECRET=YOUR_APP_SECRET_HERE
APP_ENCRYPTION_KEY=YOUR_APP_ENCRYPTION_KEY_HERE
APP_MAINTENANCE_MODE=false
APP_READ_ONLY_MODE=false
APP_DEBUG=false
APP_LOG_LEVEL=info
APP_PUBLIC_URL=YOUR_APP_PUBLIC_URL_HERE
APP_ADMIN_URL=YOUR_ADMIN_URL_HERE
APP_HEALTHCHECK_PATH=/health


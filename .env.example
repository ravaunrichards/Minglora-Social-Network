# Minglora — server environment (copy to a private .env / Render environment).
# Never commit real secrets. Browser builds must NEVER receive backend secrets.
NODE_ENV=development
PORT=3000
APP_ORIGIN=

# Authentication is owned by Minglora's dedicated Supabase project.
AUTH_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_AUTH_REDIRECT_URL=
# Compatibility aliases accepted by the authentication helper.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Development defaults to local JSON. Render production uses the Supabase Edge Function.
PERSISTENCE_DRIVER=json
SUPABASE_STATE_API_URL=
SUPABASE_STATE_API_KEY=
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATA_DIR=./data

# Minglora LiveKit Cloud — server-only credentials.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional transactional email providers.
EMAIL_PROVIDER=none
EMAIL_FROM=
RESEND_API_KEY=
SENDGRID_API_KEY=

# Optional OAuth providers — server-side secrets remain private.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional observability.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

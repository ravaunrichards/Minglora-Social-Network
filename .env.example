# Minglora — server environment (copy to a private .env / Render environment).
# Never commit real secrets. Browser builds must NEVER receive service-role or provider secrets.
NODE_ENV=development
PORT=3000
APP_ORIGIN=

# Authentication is owned by Minglora's separate Supabase project.
AUTH_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Legacy public key name supported only for compatibility; prefer SUPABASE_PUBLISHABLE_KEY.
SUPABASE_ANON_KEY=
# Server-only privileged key. Not needed for ordinary signup/login.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_REDIRECT_URL=

# Durable runtime persistence — use Minglora's own database connection.
PERSISTENCE_DRIVER=postgres
DATABASE_URL=
PGSSLMODE=require
PG_POOL_MAX=5
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATA_DIR=./data

# Minglora LiveKit Cloud — server-only credentials.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional transactional email providers.
EMAIL_PROVIDER=none
EMAIL_FROM=
RESEND_API_KEY=
SENDGRID_API_KEY=

# Optional OAuth providers — server-side secrets remain private.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional observability.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

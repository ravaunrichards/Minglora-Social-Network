# Azure OpenAI deployment.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# AWS Bedrock. Prefer the instance/task IAM role or web identity over static keys.

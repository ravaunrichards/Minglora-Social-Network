# Minglora — server environment (copy to a private .env / Render environment).
# Never commit real secrets. Browser builds must NEVER receive backend secrets.
NODE_ENV=development
PORT=3000
APP_ORIGIN=
# Comma-separated authenticated member UUIDs allowed to operate the moderator queue.
# Leave empty until the account IDs of trusted moderators have been reviewed.
MODERATOR_USER_IDS=

# Authentication is owned by Minglora's dedicated Supabase project.
AUTH_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_AUTH_REDIRECT_URL=
# Compatibility aliases accepted by the authentication helper.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Development defaults to local JSON. Render production uses the Supabase Edge Function.
PERSISTENCE_DRIVER=json
SUPABASE_STATE_API_URL=
SUPABASE_STATE_API_KEY=
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATA_DIR=./data

# Minglora LiveKit Cloud — server-only credentials.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Tenor GIF search. Keep this server-only token private; never expose it in the browser.
TENOR_API_KEY=

# Optional transactional email via SMTP (Nodemailer).
# Set EMAIL_PROVIDER=smtp only after entering provider credentials in Render.
# Reviewer alerts default to the Creator Hub owner inbox; add other reviewers as a comma-separated list.
EMAIL_PROVIDER=none
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Reserved for future provider adapters; not used by the current SMTP mailer.
RESEND_API_KEY=
SENDGRID_API_KEY=


# Optional Apple sign-in provider — server-side credentials remain private.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional observability.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# onboarding certification, tax calculation and end-to-end webhook reconciliation.
# Standard Checkout may expose basic card choices where PayPal supports them.
# Advanced branded card fields require separate underwriting and country eligibility.



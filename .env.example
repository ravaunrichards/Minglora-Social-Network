# Minglora — server environment (copy to a private .env / Render environment).
# Never commit real secrets. Browser builds must NEVER receive backend secrets.
NODE_ENV=development
PORT=3000
APP_ORIGIN=
# Comma-separated authenticated member UUIDs allowed to operate the moderator queue.
# Leave empty until the account IDs of trusted moderators have been reviewed.
MODERATOR_USER_IDS=

# Authentication is owned by Minglora's dedicated Supabase project.
AUTH_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_AUTH_REDIRECT_URL=
# Compatibility aliases accepted by the authentication helper.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Development defaults to local JSON. Render production uses the Supabase Edge Function.
PERSISTENCE_DRIVER=json
SUPABASE_STATE_API_URL=
SUPABASE_STATE_API_KEY=
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATA_DIR=./data

# Minglora LiveKit Cloud — server-only credentials.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Tenor GIF search. Keep this server-only token private; never expose it in the browser.
TENOR_API_KEY=

# Optional transactional email providers.
EMAIL_PROVIDER=none
EMAIL_FROM=
RESEND_API_KEY=
SENDGRID_API_KEY=

# Optional OAuth providers — server-side secrets remain private.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional observability.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Minglora Marketplace PayPal multiparty integration — separate from creator PayPal.
# All switches stay false until written PayPal marketplace-partner approval, seller
# onboarding certification, tax calculation and end-to-end webhook reconciliation.
MARKETPLACE_PAYPAL_MODE=sandbox
MARKETPLACE_PAYPAL_API_BASE_URL=
MARKETPLACE_PAYPAL_CLIENT_ID=
MARKETPLACE_PAYPAL_CLIENT_SECRET=
MARKETPLACE_PAYPAL_PARTNER_MERCHANT_ID=
MARKETPLACE_PAYPAL_ATTRIBUTION_ID=
MARKETPLACE_PAYPAL_WEBHOOK_ID=
MARKETPLACE_PAYPAL_ENABLED=false
MARKETPLACE_PAYPAL_PARTNER_APPROVED=false
MARKETPLACE_PAYPAL_LIVE_APPROVED=false

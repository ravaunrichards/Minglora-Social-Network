PORT=3000
NODE_ENV=development
# Local development uses JSON storage by default. Hosted production must use PostgreSQL.
# Set PERSISTENCE_DRIVER=postgres and DATABASE_URL to use durable PostgreSQL persistence.
# PERSISTENCE_DRIVER=postgres
DATABASE_URL=
# Use require for hosted PostgreSQL with TLS. Use disable only on a trusted private network.
PGSSLMODE=require
PG_POOL_MAX=5
# Set a random secret of 32+ characters for stable sessions and production deployment.
# Leave blank only for local development; production startup will refuse to run.
SESSION_SECRET=
# Optional absolute or relative writable directory for local JSON storage.
# DATA_DIR=./data

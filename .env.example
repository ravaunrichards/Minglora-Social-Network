AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
AWS_WEB_IDENTITY_TOKEN_FILE=
BEDROCK_MODEL_ID=

# Local and private OpenAI-compatible inference endpoints.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_DEFAULT_MODEL=
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_DEFAULT_MODEL=
LM_STUDIO_BASE_URL=
LM_STUDIO_API_KEY=
LM_STUDIO_DEFAULT_MODEL=
MINGLORA_AI_COMPATIBLE_BASE_URL=
MINGLORA_AI_COMPATIBLE_API_KEY=
MINGLORA_AI_COMPATIBLE_MODEL=

# Voice generation and speech recognition.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_DEFAULT_MODEL_ID=
DEEPGRAM_API_KEY=
